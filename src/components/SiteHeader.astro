---
import { PROFILE } from '~/data/site'
---

<header class="site-header">
  <div class="site-header__inner">
    <h1 class="site-header__name">
      {PROFILE.name}<span class="site-header__caret" aria-hidden="true"></span>
    </h1>
    <p class="site-header__role">{PROFILE.role}</p>
  </div>
</header>

<style>
  .site-header {
    padding: 1.5rem var(--rail);
    background: linear-gradient(180deg, var(--color-white), var(--color-surface));
    border-bottom: 3px solid var(--color-accent);
    box-shadow: inset 0 -1px 0 var(--bevel-light);
  }

  .site-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: var(--measure);
    margin-inline: auto;
  }

  .site-header__name {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 3.6rem);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.01em;
    text-shadow: 2px 2px 0 var(--color-accent-pale);
  }

  .site-header__caret {
    display: inline-block;
    width: 12px;
    height: 0.9em;
    margin-left: 4px;
    margin-bottom: 0.25em;
    background: var(--color-accent);
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }

  .site-header__role {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-lede);
    color: var(--color-ink-4);
    letter-spacing: 0.04em;
  }
</style>
