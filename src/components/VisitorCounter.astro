---
import Panel from '~/components/Panel.astro'
import { COUNTER_DIGITS } from '~/data/site'
import { formatCount } from '~/lib/counter'

const initial = formatCount(1, COUNTER_DIGITS)
---

<Panel padding="xs">
  <div class="counter">
    <p class="counter__label">You are visitor number</p>

    <p
      class="counter__odometer bevel-sunken"
      data-visit-odometer={COUNTER_DIGITS}
      aria-label="Visitor number 1"
    >
      {
        [...initial].map((cell) => (
          <span
            class:list={['counter__cell', { 'is-separator': cell === ',' }]}
            data-visit-cell
            aria-hidden="true"
          >
            {cell}
          </span>
        ))
      }
    </p>
  </div>
</Panel>

<style>
  .counter {
    text-align: center;
    font-family: var(--font-mono);
  }

  .counter__label {
    margin-bottom: 6px;
    font-size: var(--text-fine);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-7);
  }

  .counter__odometer {
    display: inline-flex;
    background: var(--color-field);
    animation: count-up 0.4s ease forwards;
  }

  .counter__cell {
    min-width: 16px;
    padding: 1px 3px;
    border-left: 1px solid var(--color-rule-soft);
    color: var(--color-ink);
    font-size: var(--text-title);
    font-weight: 700;
    line-height: 1.4;
  }

  .counter__cell:first-child {
    border-left: none;
  }

  .counter__cell.is-separator {
    min-width: 0;
    padding-inline: 0;
    border-left: none;
    color: var(--color-ink-6);
  }

  .counter__cell.is-separator + .counter__cell {
    border-left: none;
  }
</style>
