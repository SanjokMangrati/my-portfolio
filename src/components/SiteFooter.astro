---
import Icon from '~/components/Icon.astro'
import Seal from '~/components/Seal.astro'
import { GITHUB, LINKEDIN, PLACE, SITE } from '~/data/site'
---

<hr class="rule" />
<footer class="footer">
  <Seal class="footer__seal" />
  <div class="footer__end">
    <ul class="footer__links">
      <li>
        <a class="link" href={GITHUB} target="_blank" rel="noopener noreferrer"><Icon name="repo" small />GitHub</a>
      </li>
      <li>
        <a class="link" href={LINKEDIN} target="_blank" rel="noopener noreferrer"><Icon name="profile" small />LinkedIn</a>
      </li>
    </ul>
    <p class="footer__fine">
      Built at {PLACE.elevation} · {SITE.domain} · {SITE.version} · © {SITE.copyrightYear}
    </p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .footer :global(.footer__seal) {
    width: 232px;
    height: auto;
    color: var(--on-estate);
  }

  .footer__end {
    display: grid;
    gap: var(--space-3);
    justify-items: end;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer__fine {
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-estate-muted);
  }

  @media (max-width: 560px) {
    .footer__end {
      justify-items: start;
    }
  }
</style>
