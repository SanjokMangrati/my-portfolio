---
import Icon from '~/components/Icon.astro'
import StatusPill from '~/components/StatusPill.astro'
import type { Project } from '~/data/site'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
const isExternal = (href: string) => /^https?:\/\//i.test(href)
---

<ol class="ledger">
  {
    projects.map((project) => {
      const Row = project.href ? 'a' : 'div'
      return (
        <li>
          <Row
            class="ledger__row"
            href={project.href}
            aria-disabled={project.href ? undefined : 'true'}
          >
            <span class="ledger__key">{project.kind}</span>
            <span class="ledger__main">
              <h3 class="ledger__name">{project.name}</h3>
              <p class="ledger__desc">{project.desc}</p>
              <p class="ledger__stack">{project.stack.join(' / ')}</p>
            </span>
            <span class="ledger__status">
              <StatusPill status={project.status} />
            </span>
            <span class="ledger__arrow">
              <Icon name={project.href && isExternal(project.href) ? 'arrow-out' : 'arrow-right'} />
            </span>
          </Row>
        </li>
      )
    })
  }
</ol>

<style>
  .ledger {
    border-top: var(--border-hair) solid var(--hairline);
  }

  .ledger__row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto 24px;
    gap: var(--space-2) var(--space-6);
    align-items: baseline;
    padding: var(--space-6) var(--space-3);
    border-bottom: var(--border-hair) solid var(--hairline);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--duration-quick);
  }

  a.ledger__row:hover {
    background: var(--ground-raised);
  }

  .ledger__key {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .ledger__main {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .ledger__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .ledger__desc {
    max-width: 56ch;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .ledger__stack {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .ledger__arrow {
    align-self: center;
    color: var(--ink);
    transition: transform var(--duration-quick);
  }

  a.ledger__row:hover .ledger__arrow {
    transform: translateX(3px);
  }

  [aria-disabled='true'] .ledger__arrow {
    color: var(--hairline);
  }

  @media (max-width: 640px) {
    .ledger__row {
      grid-template-columns: minmax(0, 1fr) 24px;
      padding-inline: 0;
    }

    .ledger__key {
      grid-column: 1;
      grid-row: 1;
    }

    .ledger__arrow {
      grid-column: 2;
      grid-row: 1;
    }

    .ledger__main {
      grid-column: 1 / -1;
    }

    .ledger__status {
      grid-column: 1 / -1;
    }
  }
</style>
