---
import Icon from '~/components/Icon.astro'
import { PLACE } from '~/data/site'
---

<ul class="meta" aria-label="Where and when">
  <li><Icon name="summit" small /><strong>{PLACE.name}</strong></li>
  <li>{PLACE.coordinates}</li>
  <li>{PLACE.elevation}</li>
  <li><Icon name="clock" small /><span class="meta__clock" data-clock>IST</span></li>
  <li>{PLACE.offset}</li>
  <li>{PLACE.experience}</li>
</ul>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--ground-sunk);
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 11px;
    line-height: 1.45;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    border-left: var(--border-hair) solid var(--rule);
  }

  li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  strong {
    font-weight: 500;
    color: var(--ink);
  }

  li :global(.icon) {
    color: var(--ink);
  }

  .meta__clock {
    color: var(--muscatel-text);
    font-variant-numeric: tabular-nums;
  }
</style>
