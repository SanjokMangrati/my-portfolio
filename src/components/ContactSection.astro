---
import Icon from '~/components/Icon.astro'
import SectionHead from '~/components/SectionHead.astro'
import { CONTACT_INTRO, CONTACT_LINES, SITE } from '~/data/site'

const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''
const isExternal = (href: string) => /^https?:\/\//i.test(href)

const FIELDS = [
  {
    id: 'name',
    label: 'Name',
    type: 'text',
    placeholder: 'Jane Smith',
    autocomplete: 'name',
    error: 'Add your name so I know who to reply to.',
  },
  {
    id: 'email',
    label: 'Email',
    type: 'email',
    placeholder: 'jane@company.com',
    autocomplete: 'email',
    error: 'Add an email address I can reply to, like jane@company.com.',
  },
  {
    id: 'message',
    label: 'Message',
    type: 'textarea',
    placeholder: 'The role, the team, and how I can help.',
    autocomplete: 'off',
    error: 'Write a few words so I know what this is about.',
  },
] as const
---

<section class="contact" aria-labelledby="contact">
  <SectionHead label="Contact" title="Get in touch" id="contact" aside={CONTACT_INTRO} />

  <ul class="lines">
    {
      CONTACT_LINES.map((line) => {
        const external = isExternal(line.href)
        return (
          <li>
            <a
              href={line.href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <span class="lines__name">{line.label}</span>
              <span class="lines__hint">{line.hint}</span>
              <Icon name={external ? 'arrow-out' : 'arrow-right'} class="lines__icon" />
            </a>
          </li>
        )
      })
    }
  </ul>

  <form
    class="form"
    id="contact-form"
    method="POST"
    action="https://api.web3forms.com/submit"
    novalidate
    data-contact-form
    data-ready={ACCESS_KEY ? 'true' : 'false'}
  >
    <input type="hidden" name="access_key" value={ACCESS_KEY} />
    <input type="hidden" name="subject" value={`New message from ${SITE.domain}`} />
    <input type="hidden" name="from_name" value={SITE.domain} />
    <input class="form__botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {
      FIELDS.map((field) => (
        <div class="field" data-field>
          <label for={field.id}>{field.label}</label>
          {field.type === 'textarea' ? (
            <textarea
              id={field.id}
              name={field.id}
              rows="3"
              placeholder={field.placeholder}
              aria-describedby={`${field.id}-error`}
              required
            />
          ) : (
            <input
              id={field.id}
              name={field.id}
              type={field.type}
              placeholder={field.placeholder}
              autocomplete={field.autocomplete}
              aria-describedby={`${field.id}-error`}
              required
            />
          )}
          <p class="field__error" id={`${field.id}-error`} data-error={field.error} hidden />
        </div>
      ))
    }

    <div class="form__foot">
      <p class="form__note" data-form-status role="status" aria-live="polite">All three fields are needed</p>
      <button class="btn btn--primary" type="submit">
        <span data-submit-label>Send message</span>
        <Icon name="arrow-right" />
      </button>
    </div>
  </form>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--space-12);
  }

  /* Contact lines */
  .lines {
    border-top: var(--border-hair) solid var(--estate-line);
  }

  .lines li {
    border-bottom: var(--border-hair) solid var(--estate-line);
  }

  .lines a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    color: var(--on-estate);
    text-decoration: none;
  }

  .lines__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-underline-offset: 6px;
  }

  .lines__hint {
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-estate-muted);
  }

  .lines :global(.lines__icon) {
    width: 28px;
    height: 28px;
    transition: transform var(--duration-quick);
  }

  .lines a:hover :global(.lines__icon) {
    transform: translateX(3px);
  }

  .lines a:hover .lines__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 560px) {
    .lines__hint {
      display: none;
    }
  }

  /* Form: one ledger row per field, writing on the line, no filled wells */
  .form {
    display: grid;
    max-width: 760px;
  }

  .form__botcheck {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .field {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4) var(--space-2);
    border-bottom: var(--border-rule) solid var(--on-estate-muted);
    transition:
      border-color var(--duration-quick),
      box-shadow var(--duration-quick);
  }

  .field label {
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-estate-muted);
    transition: color var(--duration-quick);
  }

  .field input,
  .field textarea {
    width: 100%;
    margin: 0;
    padding: var(--space-1) 0;
    border: 0;
    border-radius: var(--radius-0);
    background: transparent;
    color: var(--on-estate);
    caret-color: var(--on-estate);
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.5;
  }

  .field textarea {
    display: block;
    min-height: 96px;
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--on-estate-muted);
    opacity: 0.8;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
  }

  .field:focus-within,
  .field[data-invalid] {
    border-bottom-color: var(--on-estate);
    box-shadow: 0 1.5px 0 var(--on-estate);
  }

  .field:focus-within label {
    color: var(--on-estate);
  }

  .field__error {
    font-size: 15px;
    line-height: 1.5;
    color: var(--on-estate);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }

  .form__note {
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-estate-muted);
  }

  .form__note[data-tone='done'] {
    color: var(--on-estate);
  }

  @media (min-width: 720px) {
    .field {
      grid-template-columns: 160px minmax(0, 1fr);
      column-gap: var(--space-6);
      align-items: baseline;
    }

    .field__error {
      grid-column: 2;
    }
  }

  @media (max-width: 560px) {
    .field input,
    .field textarea {
      font-size: 18px;
    }
  }

  @media (min-width: 900px) {
    .lines,
    .form {
      margin-left: calc(var(--rail) + var(--space-8));
    }
  }
</style>
