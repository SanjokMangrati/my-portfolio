---
import Icon from '~/components/Icon.astro'
import Monogram from '~/components/Monogram.astro'
import StatusPill from '~/components/StatusPill.astro'
import { NAV, PROFILE } from '~/data/site'

interface Props {
  /** Prefix for section links: '' on the home page, '/' elsewhere. */
  base?: string
}

const { base = '' } = Astro.props
---

<header class="wrap">
  <div class="topbar">
    <a class="topbar__id" href={base || '#top'} aria-label={`${PROFILE.name}, home`}>
      <Monogram class="topbar__mark" />
    </a>

    <nav class="topbar__nav" aria-label="Sections">
      {NAV.map((item) => <a class="mono" href={`${base}#${item.id}`}>{item.label}</a>)}
    </nav>

    <div class="topbar__end">
      {PROFILE.openToWork && <StatusPill status="open" />}
      <button class="btn btn--quiet" type="button" data-theme-toggle aria-label="Switch color theme">
        <Icon name="theme" />
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-hair) solid var(--hairline);
  }

  .topbar__id {
    display: inline-flex;
    justify-self: start;
    color: var(--ink);
    text-decoration: none;
  }

  .topbar__id :global(.topbar__mark) {
    width: 32px;
    height: 32px;
  }

  .topbar__nav {
    display: flex;
    gap: var(--space-6);
  }

  .topbar__nav a {
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color var(--duration-quick),
      border-color var(--duration-quick);
  }

  .topbar__nav a:hover,
  .topbar__nav a[aria-current] {
    color: var(--ink);
    border-bottom-color: var(--muscatel);
  }

  .topbar__end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-4);
  }

  @media (max-width: 640px) {
    .topbar {
      grid-template-columns: 1fr auto;
    }

    .topbar__nav {
      display: none;
    }
  }
</style>
