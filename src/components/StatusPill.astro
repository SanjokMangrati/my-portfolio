---
import type { Status } from '~/data/site'

interface Props {
  status: Status
}

const LABELS: Record<Status, string> = {
  open: 'Open to work',
  live: 'Live',
  progress: 'In progress',
}

const { status } = Astro.props
---

<span class:list={['status', `status--${status}`]}>
  <span class="status__dot" aria-hidden="true"></span>{LABELS[status]}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 5px 12px 5px 10px;
    border: var(--border-rule) solid var(--rule);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }

  .status__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: currentColor;
  }

  .status--open .status__dot {
    color: var(--muscatel);
  }

  .status--open .status__dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1.5px solid var(--muscatel);
    border-radius: var(--radius-pill);
    animation: pulse var(--duration-pulse) ease-out infinite;
  }

  .status--live {
    color: var(--leaf);
    border-color: var(--leaf);
  }

  .status--progress {
    color: var(--train);
    border-color: var(--train);
  }

  .status--progress .status__dot {
    background: transparent;
    border: 1.5px solid currentColor;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    80%,
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status--open .status__dot::after {
      display: none;
    }
  }
</style>
