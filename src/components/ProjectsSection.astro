---
import Section from '~/components/Section.astro'
import { PROJECTS } from '~/data/site'
---

<Section id="projects" title="Projects" framed={false}>
  <ul class="projects">
    {
      PROJECTS.map((project) => (
        <li class="project bevel-raised">
          <div class="project__top">
            <h3 class="project__name">
              <a href={project.url}>{project.name}</a>
              {project.flag && (
                <span class:list={['project__flag', `project__flag--${project.flagTone ?? 'hot'}`]}>
                  {project.flag}
                </span>
              )}
            </h3>
          </div>

          <p class="project__desc">{project.desc}</p>

          <ul class="project__tags">
            {project.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
  }

  .project {
    position: relative;
    padding: 1rem;
    background: var(--color-surface);
  }

  .project:hover {
    background: var(--color-white);
  }

  .project__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .project__name {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    font-weight: 700;
    color: var(--color-accent);
  }

  .project__name a {
    text-decoration: none;
  }

  .project__name a:hover {
    text-decoration: underline;
  }

  .project__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project__flag {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-fine);
    font-weight: 700;
    letter-spacing: 0.08em;
    vertical-align: 2px;
    white-space: nowrap;
    animation: blink 1.1s step-end infinite;
  }

  .project__flag--hot {
    color: var(--color-hot);
  }

  .project__flag--live {
    color: var(--color-online);
  }

  .project__desc {
    margin-bottom: 10px;
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-ink-4);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .chip {
    padding: 1px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-ink-3);
    background: var(--color-chrome);
    border: 1px solid;
    border-color: var(--bevel-light) var(--bevel-shadow) var(--bevel-shadow) var(--bevel-light);
  }
</style>
