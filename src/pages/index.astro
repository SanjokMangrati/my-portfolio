---
import ContactSection from '~/components/ContactSection.astro'
import EstateBand from '~/components/EstateBand.astro'
import ExperienceLog from '~/components/ExperienceLog.astro'
import Ledger from '~/components/Ledger.astro'
import Masthead from '~/components/Masthead.astro'
import MetaStrip from '~/components/MetaStrip.astro'
import Prose from '~/components/Prose.astro'
import SectionHead from '~/components/SectionHead.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import StackManifest from '~/components/StackManifest.astro'
import TopBar from '~/components/TopBar.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { ABOUT_PARAGRAPHS, PROJECTS, SKILL_GROUPS } from '~/data/site'
---

<BaseLayout>
  <TopBar />

  <main id="main">
    <div class="wrap">
      <Masthead />
      <MetaStrip />

      <section class="section" aria-labelledby="work">
        <SectionHead label="Selected work" title="Things I have built" id="work" count={PROJECTS.length} />
        <Ledger projects={PROJECTS} />
      </section>

      <hr class="rule" />

      <section class="section" aria-labelledby="about">
        <Prose label="About" labelId="about" paragraphs={ABOUT_PARAGRAPHS} />
      </section>

      <hr class="rule" />

      <section class="section" aria-labelledby="experience">
        <SectionHead label="Experience" title="Where I have worked" id="experience" />
        <ExperienceLog />
      </section>

      <hr class="rule" />

      <section class="section" aria-labelledby="stack">
        <SectionHead label="Stack" title="What I work with" id="stack" />
        <StackManifest groups={SKILL_GROUPS} />
      </section>
    </div>

    <EstateBand>
      <ContactSection />
      <SiteFooter />
    </EstateBand>
  </main>
</BaseLayout>
