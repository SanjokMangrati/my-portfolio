---
import { Image } from 'astro:assets'
import NavTabs from '~/components/NavTabs.astro'
import Section from '~/components/Section.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteHeader from '~/components/SiteHeader.astro'
import StatusBar from '~/components/StatusBar.astro'
import TechStackSection from '~/components/TechStackSection.astro'
import UtilityBar from '~/components/UtilityBar.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { ALIAS as PROJECT, PROFILE } from '~/data/site'

---

<BaseLayout title={`${PROJECT.title} — ${PROFILE.name}`} description={PROJECT.tagline}>
  <UtilityBar />
  <SiteHeader />
  <NavTabs base="/" active={-1} />

  <main class="page">
    <div class="head">
      <p class="crumb"><a href="/#projects">&laquo; Back to projects</a></p>

      <div class="masthead bevel-raised">
        <div class="masthead__text">
          <h2 class="masthead__name">{PROJECT.title}</h2>
          <p class="masthead__tagline">{PROJECT.tagline}</p>
        </div>

        <a
          class="key bevel-raised"
          href={PROJECT.live}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open &raquo;
        </a>
      </div>
    </div>

    <Section id="overview" title="Overview">
      <div class="prose">
        {PROJECT.description.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Section>

    <Section id="peek" title="Sneak Peek" padding="xs">
      <div class="shot bevel-sunken">
        <Image
          src={PROJECT.screenshot.src}
          alt={PROJECT.screenshot.alt}
          widths={[640, 960, 1280, 1915]}
          sizes="(min-width: 68rem) 61rem, 100vw"
          quality={92}
          loading="lazy"
          decoding="async"
        />
      </div>
    </Section>

    <TechStackSection id="stack" title="Tech Stack" groups={PROJECT.stack} />

    <Section id="live" title="Deployed" padding="sm">
      <div class="live">
        <a class="key bevel-raised" href={PROJECT.live} target="_blank" rel="noopener noreferrer">
          Open {PROJECT.title} &raquo;
        </a>
        <p class="live__url">{PROJECT.live}</p>
      </div>
    </Section>
  </main>

  <SiteFooter />
  <StatusBar />
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: var(--measure);
    margin-inline: auto;
    padding: 2rem var(--rail);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .crumb {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(180deg, var(--color-white), var(--color-surface));
  }

  .masthead__text {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .masthead__name {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-accent);
    text-shadow: 2px 2px 0 var(--color-accent-pale);
  }

  .masthead__tagline {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-lede);
    color: var(--color-ink-4);
    letter-spacing: 0.02em;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: var(--text-prose);
    line-height: 1.8;
    color: var(--color-ink-2);
  }

  .shot {
    background: var(--color-white);
    line-height: 0;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .live {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .key {
    padding: 5px 20px;
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    background: var(--color-chrome);
    text-decoration: none;
  }

  .key:visited {
    color: var(--color-ink);
  }

  .key:hover {
    color: var(--color-hot);
  }

  .key:active {
    padding: 6px 19px 4px 21px;
    border-color: var(--bevel-shadow) var(--bevel-light) var(--bevel-light) var(--bevel-shadow);
    box-shadow:
      inset 1px 1px 0 var(--bevel-dark),
      inset -1px -1px 0 var(--bevel-highlight);
  }

  .live__url {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-ink-5);
    overflow-wrap: anywhere;
  }
</style>
