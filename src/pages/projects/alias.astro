---
import { Image } from 'astro:assets'
import EstateBand from '~/components/EstateBand.astro'
import Icon from '~/components/Icon.astro'
import Prose from '~/components/Prose.astro'
import SectionHead from '~/components/SectionHead.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import StackManifest from '~/components/StackManifest.astro'
import StatusPill from '~/components/StatusPill.astro'
import TopBar from '~/components/TopBar.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { ALIAS as PROJECT, PROFILE } from '~/data/site'

const liveHost = new URL(PROJECT.live).host
const mainStack = PROJECT.stack
  .filter((group) => group.category === 'Frontend' || group.category === 'Backend')
  .flatMap((group) => group.items)
  .slice(0, 5)
---

<BaseLayout title={`${PROJECT.title} — ${PROFILE.name}`} description={PROJECT.tagline}>
  <TopBar base="/" />

  <main id="main" class="wrap">
    <header class="case">
      <a class="btn btn--quiet case__back" href="/#work"><Icon name="arrow-left" />All work</a>
      <span class="label">Case study</span>
      <h1 class="case__title">{PROJECT.title}</h1>
      <p class="case__tagline">{PROJECT.tagline}</p>

      <dl class="facts">
        <div>
          <dt>Status</dt>
          <dd><StatusPill status="live" /></dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{mainStack.join(', ')}</dd>
        </div>
        <div>
          <dt>Integrations</dt>
          <dd>{PROJECT.integrations.join(', ')}</dd>
        </div>
        <div>
          <dt>Live at</dt>
          <dd><a class="link" href={PROJECT.live} target="_blank" rel="noopener noreferrer">{liveHost}</a></dd>
        </div>
      </dl>

      <figure class="shot">
        <div class="shot__mat">
          <Image
            src={PROJECT.screenshot.src}
            alt={PROJECT.screenshot.alt}
            widths={[640, 960, 1280, 1915]}
            sizes="(min-width: 1280px) 1176px, calc(100vw - 32px)"
            quality={92}
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption><b>Fig. 1</b> — The pipeline screen: each application with its match score, stage and status.</figcaption>
      </figure>
    </header>

    <section class="section" aria-labelledby="overview">
      <Prose label="Overview" labelId="overview" paragraphs={PROJECT.description}>
        <p class="case__cta">
          <a class="btn btn--primary" href={PROJECT.live} target="_blank" rel="noopener noreferrer">
            Visit {liveHost}
            <Icon name="arrow-out" />
          </a>
        </p>
      </Prose>
    </section>

    <hr class="rule" />

    <section class="section" aria-labelledby="alias-stack">
      <SectionHead label="Stack" title="What it runs on" id="alias-stack" />
      <StackManifest groups={PROJECT.stack} />
    </section>
  </main>

  <EstateBand>
    <div class="next">
      <span class="label">Next</span>
      <a class="next__link" href="/#contact">
        <span>Get in touch</span>
        <Icon name="arrow-right" class="next__icon" />
      </a>
    </div>
    <SiteFooter />
  </EstateBand>
</BaseLayout>

<style>
  .case {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12) var(--space-8);
  }

  .case__back {
    justify-self: start;
  }

  .case__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(56px, 9vw, 96px);
    line-height: 0.85;
    text-transform: uppercase;
  }

  .case__tagline {
    max-width: 40ch;
    font-size: 21px;
    line-height: 1.6;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-top: var(--border-hair) solid var(--hairline);
    border-bottom: var(--border-hair) solid var(--hairline);
  }

  .facts div {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .facts dd {
    font-size: 15px;
    line-height: 1.5;
  }

  .shot {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .shot__mat {
    padding: var(--space-3);
    background: var(--ground-raised);
    border: var(--border-hair) solid var(--rule);
  }

  .shot__mat :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    font-family: var(--font-mono);
    font-stretch: 75%;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  figcaption b {
    font-weight: 500;
    color: var(--ink);
  }

  .case__cta {
    padding-top: var(--space-4);
  }

  .next {
    display: grid;
    gap: var(--space-3);
  }

  .next__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    justify-self: start;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--on-estate);
    text-decoration: none;
    text-underline-offset: 6px;
  }

  .next__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .next__link :global(.next__icon) {
    width: 36px;
    height: 36px;
  }
</style>
